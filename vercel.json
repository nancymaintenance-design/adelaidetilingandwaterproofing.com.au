{
  "functions": {
    "api/contact.js": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/products.html",
      "destination": "/services.html",
      "permanent": true
    },
    {
      "source": "/news.html",
      "destination": "/faq.html",
      "permanent": true
    },
    {
      "source": "/tiling-adelaide.html",
      "destination": "/services.html#room-tiling",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|gif|svg|ico|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
