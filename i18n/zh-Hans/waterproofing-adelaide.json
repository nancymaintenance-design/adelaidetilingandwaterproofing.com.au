    "waterproofing-adelaide.html/html[1]/body[1]/main[4]/section[1]/div[0]/div[0]/p[2]/#text[0]": {
      "source": "Waterproofing for local bathrooms, laundries and wet areas, with roof, balcony and exterior enquiries assessed for the surface and exposure. Ellis coordinates preparation, membrane work and tiling where included; the on-site assessment leads to an itemised written quote.",
      "target": "为本地浴室、洗衣房与湿区提供防水，并按表面和暴露条件评估屋顶、阳台及室外需求。Ellis 协调基层处理、防水膜及约定的贴砖工作，经现场评估后提供分项书面报价。"
    },
    "waterproofing-adelaide.html/html[1]/body[1]/main[4]/section[1]/div[0]/div[0]/a[3]/#text[0]": {
      "source": "GET YOUR PROJECT QUOTE ↗",
      "target": "获取您的项目报价 ↗"
    },
    "waterproofing-adelaide.html/html[1]/body[1]/main[4]/section[1]/div[0]/figure[1]/img[0]@alt": {
      "source": "A worker applying blue waterproofing membrane to a shower wall",
      "target": "工人在淋浴墙面涂刷蓝色防水膜"
    },
    "waterproofing-adelaide.html/html[1]/body[1]/main[4]/section[3]/div[0]/h2[0]/#text[0]": {
      "source": "Choose the area that needs waterproofing",
      "target": "选择需要防水的区域"
    },
    "waterproofing-adelaide.html/html[1]/body[1]/main[4]/section[3]/div[0]/p[1]/#text[0]": {
      "source": "Start with the affected surface. A new membrane and an existing leak need different assessment; pipe leaks require separate plumbing work.",
      "target": "从受影响表面开始。新防水膜施工与现有渗漏的评估不同；管道渗漏需要单独的管道维修。"
    },
    "waterproofing-adelaide.html/html[1]/body[1]/main[4]/section[3]/div[0]/div[2]/section[0]/div[0]/h2[0]/#text[0]": {
      "source": "Wet-area installation and repair",
      "target": "室内湿区安装与维修"
    },
